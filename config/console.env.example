# Copy to .local-config/console.env (ignored by git) and edit.
# Never commit the real file. Use an address on your own LAN.

# Console IP address or hostname (RFC 5737 documentation example below).
PS5_HOST=192.0.2.10

# ps5-payload-elfldr port (9021 once elfldr is running; 9020 is the
# rudimentary loader provided by some exploit entry points).
PS5_PORT=9021

# Optional: FTP server port if you run an FTP payload (e.g. ftpsrv: 2121).
PS5_FTP_PORT=2121
